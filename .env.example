# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=-1000000000000
CREATOR_USERNAME=your_creator_username
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow
SHUTDOWN_GRACE_SECONDS=30

# LLM providers and budgets
LLM_PROVIDER=grok
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ENABLED=true
OPENAI_CHAT_ID=-1000000000000
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT=20
XAI_API_KEY=your_xai_api_key_here
# XAI_MODEL is a supported compatibility fallback for XAI_REPLY_MODEL.
XAI_MODEL=grok-4.5
XAI_REPLY_MODEL=grok-4.5
XAI_SUMMARY_MODEL=grok-4.3
XAI_REPLY_REASONING_EFFORT=low
XAI_SUMMARY_REASONING_EFFORT=none
XAI_BASE_URL=https://api.x.ai/v1
XAI_TIMEOUT=60
XAI_DAILY_CHAT_BUDGET_USD=0
SHORT_MAX_OUTPUT_TOKENS=120
TROLL_USER_MAX_OUTPUT_TOKENS=180
OPINION_MAX_OUTPUT_TOKENS=240
RECOMMENDATION_MAX_OUTPUT_TOKENS=280
USEFUL_MAX_OUTPUT_TOKENS=360
RECIPE_MAX_OUTPUT_TOKENS=480
COMPLEX_MAX_OUTPUT_TOKENS=460
AUTONOMOUS_MAX_OUTPUT_TOKENS=90
MEME_MAX_OUTPUT_TOKENS=50
SUMMARY_MAX_OUTPUT_TOKENS=240

# Process-local concurrency
LLM_MAX_CONCURRENCY=2
MEDIA_MAX_CONCURRENCY=1
LLM_ADMISSION_TIMEOUT_SECONDS=5
MEDIA_ADMISSION_TIMEOUT_SECONDS=15

# Learning, routing and local generation
LEARNING_ENABLED=true
DEFAULT_ACTIVITY_PERCENT=100
MIN_TRAINING_MESSAGES=20
RANDOM_REPLY_CHANCE=0.24
ACTIVE_CHAT_REPLY_CHANCE=0.16
LLM_RANDOM_REPLY_CHANCE=0.12
REPLY_TO_STUL_CHANCE=0.40
TROLL_USER_PROBABILITY=0.50
STUL_MARKOV_REPLY_CHANCE=0.50
FREQUENT_STUL_MARKOV_CHANCE=0.80
BARE_STUL_REPLY_FACTOR=0.35
SGLYPA_REPLY_CHANCE=0.375
TRIGGER_REACTION_CHANCE=0.08
TRIGGER_REACTION_COOLDOWN=1800
GENERATED_MESSAGE_COOLDOWN=300
ADDRESSED_REPLY_COOLDOWN=60
MAX_GENERATED_PER_HOUR=10
MAX_GENERATED_WORDS=35
MIN_GENERATED_WORDS=3
MAX_STORED_TEXT_LENGTH=2000
ALLOW_USER_MENTIONS=false
SPECIAL_PHRASES=сглыпа стул,киберстул
DIRECT_SOCIAL_MARKOV_SHARE=0.12
MODE_MARKOV_WEIGHT=0.42
MODE_COMBINE_WEIGHT=0.18
MODE_QUOTE_MUTATION_WEIGHT=0.16
MODE_CONTEXTUAL_WEIGHT=0.20
MODE_RANDOM_OLD_PHRASE_WEIGHT=0.04
MODEL_CACHE_SIZE=20
MARKOV_EXCLUDE_RECENT_MESSAGES=3
MARKOV_MIN_MESSAGE_AGE_SECONDS=120
MARKOV_RECENT_HISTORY_SIZE=10

# Context and conversation policy
MAX_MESSAGES_PER_CHAT=50
CONTEXT_MESSAGE_LIMIT=20
REPLY_CONTEXT_MESSAGE_LIMIT=8
TARGETED_CONTEXT_MESSAGE_LIMIT=10
COMPLEX_CONTEXT_MESSAGE_LIMIT=20
AUTONOMOUS_CONTEXT_MESSAGE_LIMIT=8
SHORT_MEMORY_MINUTES=30
PENDING_CONVERSATION_TTL_SECONDS=1200
STATE_LOW_MESSAGE_COUNT=2
STATE_LOW_SILENCE_SECONDS=600
STATE_HIGH_MESSAGES_5M=8
STATE_HIGH_MESSAGES_1M=4
STATE_BURST_MESSAGES_1M=8
STATE_BURST_PARTICIPANTS=3
STATE_TOPIC_MIN_OCCURRENCES=2
STATE_TOPIC_MIN_MESSAGES=2
POLICY_BURST_PROBABILITY_CAP=0.48

# Autonomous behavior
QUIET_START_HOUR=23
QUIET_END_HOUR=8
AUTONOMOUS_ON_WEEKENDS=false
AUTONOMOUS_MIN_SILENCE=300
AUTONOMOUS_MAX_SILENCE=21600
AUTONOMOUS_COOLDOWN=7200
AUTONOMOUS_BOT_PAUSE=2700
AUTONOMOUS_NO_RESPONSE_COOLDOWN=21600
AUTONOMOUS_DAILY_LIMIT=3
AUTONOMOUS_ACTIVE_MESSAGE_COUNT=6
AUTONOMOUS_PROBABILITY_CAP=0.30
AUTONOMOUS_WORK_HOUR_FACTOR=0.85
AUTONOMOUS_EVENING_FACTOR=1.0

# Background memory lifecycle
SUMMARY_MESSAGE_INTERVAL=50
SUMMARY_TIME_INTERVAL=1200
SUMMARY_BATCH_MESSAGES=50
SUMMARY_BATCH_CHARS=20000
SUMMARY_CLAIM_LEASE_SECONDS=300
SUMMARY_FAILURE_BACKOFF_BASE_SECONDS=300
SUMMARY_FAILURE_BACKOFF_CAP_SECONDS=21600
MAX_UNSUMMARIZED_MESSAGES=500
MAX_LONG_MEMORIES=40
MAX_MEMORY_CANDIDATES=200
MEMORY_CANDIDATE_STALE_DAYS=30
MEMORY_CANDIDATE_PROMOTED_RETENTION_DAYS=7
DAILY_SUMMARY_RETENTION_DAYS=90

# Persistence and retention
LEARNING_DATA_DIR=data
LLM_CALL_RETENTION_DAYS=90
ROUTING_EVENT_RETENTION_DAYS=31
SCHEDULED_EVENT_RETENTION_DAYS=14
SCHEDULED_CLAIM_LEASE_SECONDS=120
SCHEDULED_DELIVERY_MAX_ATTEMPTS=5
SCHEDULED_RETRY_BACKOFF_BASE_SECONDS=30
SCHEDULED_RETRY_BACKOFF_CAP_SECONDS=3600
PERSISTENCE_MAINTENANCE_INTERVAL_SECONDS=86400

# Media
GIF_ENABLED=true
MAX_GIFS_PER_CHAT=1000
STICKER_ENABLED=true
MAX_STICKERS_PER_CHAT=1000
MEDIA_REPLY_CHANCE=0.18
MEDIA_HUMOR_BONUS=0.14
MEDIA_ARGUMENT_BONUS=0.08
MEDIA_MEME_CHANCE=0.55
MEDIA_GIF_SHARE=0.72
MEDIA_COOLDOWN=600
MEDIA_TEMPLATE_COOLDOWN=3600
MEDIA_RECENT_LIMIT=12
MEME_RENDER_COOLDOWN=1800
MANUAL_MEME_COOLDOWN=120
MEME_QUOTE_MAX_CHARS=140
MEME_QUOTE_HARD_LIMIT=600
CHAT_IMAGE_BACKGROUND_CHANCE=0.35
MAX_CHAT_IMAGES_PER_CHAT=2000
MAX_CHAT_IMAGE_BYTES=20971520
MAX_CHAT_IMAGE_DIMENSION=12000
MAX_CHAT_IMAGE_PIXELS=48000000
